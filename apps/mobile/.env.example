# Copy to .env and fill in from Firebase Console → Project settings → Your apps (Web app config).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=wisepath-v2.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=wisepath-v2
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Local testing against the Firebase emulators (never in a release build):
# EXPO_PUBLIC_USE_EMULATORS=true
# EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2   # Android emulator → your computer
